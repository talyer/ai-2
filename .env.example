# 복사해서 .env로 만드시면 됩니다. 
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ai_fashion_shop
DB_USER=fashion_app
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD= hange_this_root_password
DB_SSL=false

JWT_SECRET=openssl rand - hex 32 명령어 후 복사에서 .env에다가 작성
JWT_EXPIRES_IN=2h
COOKIE_SECURE=false
TRUST_PROXY=false

SOC_ENABLED=true
SOC_AI_ENABLED=false # 지금은 AI 꺼서 개발 킬때는 true
SOC_DEMO_MODE=true

SOC_INCIDENT_THRESHOLD=60
SOC_FAILED_LOGIN_LIMIT=5
SOC_CORRELATION_MINUTES=5
SOC_IP_BLOCK_MINUTES=10
SOC_LOG_RETENTION_DAYS=30

AI_ENABLED=true
REVIEW_AI_PROVIDER=mock # 나중에 clova로 변경
SOC_AI_PROVIDER=ollama

OLLAMA_URL=http://NAS_IP:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=120000

CLOVA_ENABLED=false # 지금은 AI 꺼서 개발 킬때는 true
CLOVA_STUDIO_API_URL=
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_MODEL=
CLOVA_TIMEOUT_MS=15000

SEED_ADMIN_PASSWORD=12자이상_긴_관리자_비밀번호세팅하시면_됩니다.
