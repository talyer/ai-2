<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  
  <title><%= typeof title !== 'undefined' ? title : '로그인' %></title>

  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/auth.css">
  <script type="module" src="/vendor/altcha/altcha.js"></script>
</head>

<body>
  <main class="auth-container">
    <section class="auth-box">
      <h1>로그인</h1>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <p class="error-message" role="alert">
          <%= errorMessage %>
        </p>
      <% } %>

      <% const isBotProtectionEnabled = 
        typeof botProtectionEnabled !== 'undefined' && botProtectionEnabled;
      %>

      <form
        id="loginForm"
        method="post"
        action="/auth/login"
        data-altcha-form
      >
        <div class="form-group">
          <label for="loginId">아이디</label>

          <input
            type="text"
            id="loginId"
            name="loginId"
            value="<%=
              typeof formData !== 'undefined' && formData.loginId
                ? formData.loginId
                : ''
            %>"
            minlength="4"
            maxlength="50"
            autocomplete="username"
            required
          >
        </div>

        <div class="form-group">
          <label for="loginPassword">비밀번호</label>

          <input
            type="password"
            id="loginPassword"
            name="password"
            minlength="8"
            maxlength="100"
            autocomplete="current-password"
            required
          >
        </div>
        <% if (isBotProtectionEnabled) {%>
          <section class="bot-check-box">
            <h2>보안 확인</h2>
            <p>자동화된 요청이 아닌지 확인합니다.</p>

            <altcha-widget 
              challenge="/security/bot/challenge"
              name="altcha"
              type="checkbox"
              ></altcha-widget>

              <p class="altcha-status"
                data-altcha-status
                aria-live="polite">
              계속하려면 사람인지 확인해 주세요.</p>
          </section>
        <% } %>
        <button type="submit" 
          class="primary-button"
          data-altcha-submit
          <%= isBotProtectionEnabled ? 'disabled' : '' %> 
        >
          로그인
        </button>
        <input 
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>">
      </form>

      <div class="auth-links">
        <p>
          아직 계정이 없나요?
          <a href="/auth/signup">회원가입</a>
        </p>

        <a href="/">홈으로 돌아가기</a>
      </div>
    </section>
  </main>
  <script src="/js/altcha-form.js" defer></script>

</body>
</html>
