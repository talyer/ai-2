<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= typeof title !== 'undefined' ? title : '로그인' %></title>

  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
  <main class="auth-container">
    <section class="auth-box">
      <h1>로그인</h1>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <p class="error-message" role="alert">
          <%= errorMessage %>
        </p>
      <% } %>

      <form
        id="loginForm"
        method="post"
        action="/auth/login"
      >
        <div class="form-group">
          <label for="loginId">아이디</label>

          <input
            type="text"
            id="loginId"
            name="loginId"
            value="<%=
              typeof formData !== 'undefined' && formData.loginId
                ? formData.loginId
                : ''
            %>"
            minlength="4"
            maxlength="50"
            autocomplete="username"
            required
          >
        </div>

        <div class="form-group">
          <label for="loginPassword">비밀번호</label>

          <input
            type="password"
            id="loginPassword"
            name="password"
            minlength="8"
            maxlength="100"
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" class="primary-button">
          로그인
        </button>
      </form>

      <div class="auth-links">
        <p>
          아직 계정이 없나요?
          <a href="/auth/signup">회원가입</a>
        </p>

        <a href="/">홈으로 돌아가기</a>
      </div>
    </section>
  </main>
</body>
</html>