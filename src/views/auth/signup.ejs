<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  
  <title>회원가입</title>
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/auth.css">  
  <script type="module" src="/vendor/altcha/altcha.js"></script>

  <style>
    body { font-family: Arial, sans-serif; margin: 20px;}
    form { max-width: 400px; margin: 0 auto; }
    h1 {
    text-align: center;
    margin-top: 150px;
    }
    label { display: block; margin-top: 10px; }
    input { width: 100%; padding: 5px; }
    .message { color: red; margin-top: 5px; }
    button { padding: 5px 10px; margin-top: 10px; }
  </style>
</head>
<body>
  <h1>회원가입</h1>

  <% if (errorMessage) { %>
  <p class="message"><%= errorMessage %></p>
<% } %>
  <% const isBotProtectionEnabled = 
    typeof botProtectionEnabled !== 'undefined' &&
    botProtectionEnabled;
  %>


  <form method="post" action="/auth/signup" data-altcha-form>
  <label for="displayName">이름</label>
  <input type="text" id="displayName" name="displayName" placeholder="이름을 입력하세요">

  <label for="loginId">아이디</label>
  <input type="text" id="loginId" name="loginId" placeholder="아이디를 입력하세요">

  <label for="email">이메일</label>
  <input type="email" id="email" name="email" placeholder="이메일을 입력하세요">

  <label for="password">비밀번호</label>
  <input type="password" id="password" name="password" placeholder="비밀번호를 입력하세요">
  <% if (isBotProtectionEnabled) { %>
    <section class="bot-check-box">
            <h2>보안 확인</h2>
            <p>자동화된 요청이 아닌지 확인합니다.</p>

            <altcha-widget 
              challenge="/security/bot/challenge"
              name="altcha"
              type="checkbox"
              ></altcha-widget>

            <p class="altcha-status"
              data-altcha-status
              aria-live="polite">
              계속하려면 사람인지 확인해 주세요.
            </p>
          </section>
  <% } %>
  <button 
    type="submit"
    class="primary-button"
    data-altcha-submit
    <%= isBotProtectionEnabled ? 'disabled' : ''%>
  >
    회원가입
  </button>
  <input 
    type="hidden"
    name="_csrf"
    value="<%= csrfToken %>">
  </form>
  <script src="/js/altcha-form.js" defer></script>
</body>
</html>
