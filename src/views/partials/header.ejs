<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset = "UTF-8">
  <meta
    name = "viewport"
    content = "width=device-width, initial-scale = 1.0">
  <title><%= title %></title>

  <link rel = "stylesheet" href="/css/common.css">
  <script src=  "/js/common.js" defer></script>
</head>

<body>
  <header class ="site-header">
    <div class = "container header-content">
      <a class = "logo" href="/">
        AI Fashion Review
      </a>
      <nav class ='site-naviagtion'>
        <a href="/">홈</a>
        <a href="/products">상품</a>
        <a href="/auth/login">로그인</a>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>

          <a href="/orders/history">주문 내역</a>

          <span class = "current-user">
            <%= currentUser.displayName || currentUser.loginId %>님
          </span>

          <form
            method="post"
            action="/auth/logout"
            class="logout-form">
            <input
              type="hidden"
              name="_csrf"
              value="<%= typeof csrfToken !== 'underfined' ? csrfToken : '' %>">

              <button 
                type="submit"
                class="logout-button">로그아웃</button>
          </form>
        <% } else { %>
          <a href="/auth/signup">회원가입</a>

          <a href="/auth/login">로그인</a>
        <% } %>
      </nav>
    </div>
  </header>
