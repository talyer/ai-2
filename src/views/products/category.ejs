<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/css/common.css"
  >
</head>

<body>
  <main>
    <h1><%= title %></h1>

    <p>
      현재 카테고리:
      <strong><%= category %></strong>
    </p>

    <% if (
      Array.isArray(products) &&
      products.length > 0
    ) { %>

      <section class="product-list">
        <% products.forEach((product) => { %>

          <article class="product-card">
            <img
              src="<%= product.imageUrl %>"
              alt="<%= product.name %>"
            >

            <h2>
              <%= product.name %>
            </h2>
          </article>

        <% }) %>
      </section>

    <% } else { %>

      <p>
        아직 등록된 상품이 없습니다.
      </p>

    <% } %>

    <p>
      <a href="/">
        ← 메인으로 돌아가기
      </a>
    </p>
  </main>
</body>
</html>