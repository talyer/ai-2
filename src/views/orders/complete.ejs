<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title %> | HANSEI 쇼핑몰
  </title>

  <link
    rel="stylesheet"
    href="/css/common.css"
  >

  <link
    rel="stylesheet"
    href="/css/order.css"
  >
</head>

<body>
  <main class="order-container">
    <section class="order-box">

      <% if (order.status === 'PENDING') { %>
        <h1>주문이 접수되었습니다</h1>

        <p class="order-guide">
          현재 프로젝트에는 실제 결제 기능이 없으므로
          주문 대기 상태로 저장됩니다.
        </p>
      <% } else { %>
        <h1>주문 상세</h1>

        <p class="order-guide">
          주문 상태와 구매한 상품을 확인할 수 있습니다.
        </p>
      <% } %>

      <!-- 주문 기본 정보 -->
      <dl class="order-information">
        <div>
          <dt>주문번호</dt>

          <dd>
            <%= order.order_number %>
          </dd>
        </div>

        <div>
          <dt>주문 상태</dt>

          <dd>
            <% if (order.status === 'PENDING') { %>
              주문 대기
            <% } else if (order.status === 'PAID') { %>
              결제 완료
            <% } else if (order.status === 'SHIPPING') { %>
              배송 중
            <% } else if (order.status === 'DELIVERED') { %>
              구매확정 완료
            <% } else if (order.status === 'CANCELLED') { %>
              주문 취소
            <% } else { %>
              상태 확인 필요
            <% } %>
          </dd>
        </div>

        <div>
          <dt>총 주문금액</dt>

          <dd>
            <%=
              Number(order.total_amount)
                .toLocaleString('ko-KR')
            %>원
          </dd>
        </div>

        <div>
          <dt>주문일시</dt>

          <dd>
            <%=
              new Date(order.ordered_at)
                .toLocaleString('ko-KR')
            %>
          </dd>
        </div>
      </dl>

      <!-- 구매확정 영역 -->
      <% if (order.status === 'PENDING') { %>
        <section class="purchase-confirm-box">
          <h2>구매확정</h2>

          <p>
            구매확정을 누르면 상품을 받은 것으로 처리되며,
            해당 상품의 리뷰를 작성할 수 있습니다.
          </p>

          <form
            method="post"
            action="/orders/<%= order.order_number %>/confirm"
          >
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >

            <button
              type="submit"
              class="confirm-order-button"
            >
              구매확정
            </button>
          </form>
        </section>
      <% } else if (order.status === 'DELIVERED') { %>
        <section class="purchase-confirmed-box">
          <p>
            구매확정이 완료된 주문입니다.
          </p>
        </section>
      <% } %>

      <!-- 주문 상품 영역 -->
      <section class="order-items">
        <h2>주문 상품</h2>

        <% if (
          Array.isArray(order.items) &&
          order.items.length > 0
        ) { %>

          <% order.items.forEach((item) => { %>
            <article class="order-item">

              <!-- 상품 이미지 -->
              <% if (item.image_url) { %>
                <img
                  src="<%= item.image_url %>"
                  alt="<%= item.product_name_snapshot %>"
                >
              <% } else { %>
                <div class="order-image-placeholder">
                  이미지 준비 중
                </div>
              <% } %>

              <div class="order-item-information">
                <h3>
                  <%= item.product_name_snapshot %>
                </h3>

                <p>
                  수량:
                  <%= item.quantity %>개
                </p>

                <p>
                  상품 가격:
                  <%=
                    Number(item.unit_price)
                      .toLocaleString('ko-KR')
                  %>원
                </p>

                <p>
                  상품 합계:
                  <%=
                    (
                      Number(item.unit_price) *
                      Number(item.quantity)
                    ).toLocaleString('ko-KR')
                  %>원
                </p>

                <!-- 리뷰 상태 및 작성 폼 -->
                <% if (order.status !== 'DELIVERED') { %>

                  <p class="review-waiting-message">
                    구매확정 후 리뷰를 작성할 수 있습니다.
                  </p>

                <% } else if (item.review_id) { %>

                  <p class="review-completed-message">
                    리뷰 작성 완료
                  </p>

                  <a
                    href="/products/detail/<%= item.product_id %>"
                    class="review-product-link"
                  >
                    상품 상세에서 리뷰 확인하기
                  </a>

                <% } else { %>

                  <form
                    method="post"
                    action="/reviews"
                    class="review-form"
                  >
                    <!-- CSRF 보안 토큰 -->
                    <input
                      type="hidden"
                      name="_csrf"
                      value="<%= csrfToken %>"
                    >

                    <!-- 실제 구매 상품 번호 -->
                    <input
                      type="hidden"
                      name="orderItemId"
                      value="<%= item.id %>"
                    >

                    <div class="review-field">
                      <label for="rating-<%= item.id %>">
                        평점
                      </label>

                      <select
                        id="rating-<%= item.id %>"
                        name="rating"
                        required
                      >
                        <option value="">
                          평점을 선택해주세요.
                        </option>

                        <option value="5">
                          5점 - 매우 만족
                        </option>

                        <option value="4">
                          4점 - 만족
                        </option>

                        <option value="3">
                          3점 - 보통
                        </option>

                        <option value="2">
                          2점 - 불만족
                        </option>

                        <option value="1">
                          1점 - 매우 불만족
                        </option>
                      </select>
                    </div>

                    <div class="review-field">
                      <label for="content-<%= item.id %>">
                        리뷰 내용
                      </label>

                      <textarea
                        id="content-<%= item.id %>"
                        name="content"
                        minlength="2"
                        maxlength="2000"
                        rows="5"
                        placeholder="상품에 대한 리뷰를 작성해주세요."
                        required
                      ></textarea>
                    </div>

                    <button
                      type="submit"
                      class="review-submit-button"
                    >
                      리뷰 등록
                    </button>
                  </form>

                <% } %>
              </div>
            </article>
          <% }); %>

        <% } else { %>
          <p class="empty-order-message">
            주문 상품이 없습니다.
          </p>
        <% } %>
      </section>

      <!-- 화면 이동 버튼 -->
      <div class="order-actions">
        <a href="/orders/history">
          주문 내역
        </a>

        <a href="/products">
          상품 둘러보기
        </a>

        <a href="/">
          메인으로 이동
        </a>
      </div>
    </section>
  </main>
</body>
</html>