<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title %> | HANSEI 쇼핑몰
  </title>

  <link
    rel="stylesheet"
    href="/css/common.css"
  >

  <link
    rel="stylesheet"
    href="/css/order.css"
  >
</head>

<body>
  <main class="order-container">
    <section class="order-box">
      <h1>주문이 접수되었습니다</h1>

      <p class="order-guide">
        현재 프로젝트에는 실제 결제 기능이 없으므로
        주문 대기 상태로 저장됩니다.
      </p>

      <dl class="order-information">
        <div>
          <dt>주문번호</dt>
          <dd>
            <%= order.order_number %>
          </dd>
        </div>

        <div>
          <dt>주문 상태</dt>
          <dd>
            <% if (order.status === 'PENDING') { %>
              주문 대기
            <% } else if (order.status === 'PAID') { %>
              결제 완료
            <% } else if (order.status === 'SHIPPING') { %>
              배송 중
            <% } else if (order.status === 'DELIVERED') { %>
              배송 완료
            <% } else { %>
              주문 취소
            <% } %>
          </dd>
        </div>

        <div>
          <dt>총 주문금액</dt>
          <dd>
            <%=
              Number(order.total_amount)
                .toLocaleString('ko-KR')
            %>원
          </dd>
        </div>

        <div>
          <dt>주문일시</dt>
          <dd>
            <%=
              new Date(order.ordered_at)
                .toLocaleString('ko-KR')
            %>
          </dd>
        </div>
      </dl>
      
      <% if (order.status === 'PENDING') { %>
        <section class ="purchase-confirm-box">
          <h2>구매확정</h2>
          <p>실제 상품을 받은 것으로 처리하고 리뷰 작성을 활성화합니다.</p>
          <form 
            method="post"
            action="/orders/<%= order.order_number %>/confirm"
          >
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >

            <button 
              type="submit"
              class="confirm-order-button"
            >구매확정</button>
          </form>
        </section>
      <% } else if (order.status === 'DELIVERED') { %>
        <section class="purchase-confirmed-box">
          <p>구매확정이 완료된 주문입니다.ㄴ</p>
        </section>
      <% } %>  

      <section class="order-items">
        <h2>주문 상품</h2>

        <% if (
          Array.isArray(order.items) &&
          order.items.length > 0
        ) { %>

          <% order.items.forEach((item) => { %>
            <article class="order-item">
              <% if (item.image_url) { %>
                <img
                  src="<%= item.image_url %>"
                  alt="<%= item.product_name_snapshot %>"
                >
              <% } %>

              <div>
                <h3>
                  <%= item.product_name_snapshot %>
                </h3>

                <p>
                  수량:
                  <%= item.quantity %>개
                </p>

                <p>
                  가격:
                  <%=
                    Number(item.unit_price)
                      .toLocaleString('ko-KR')
                  %>원
                </p>
                <% if (order.status !== 'DELIVERED') { %>
                  <p class="review-waiting-message">구매 확정 후 리뷰를 작성할 수 있습니다.</p>
                  
                <% } else if (item.review_id) { %>
                  <p class="review-completed-message">리뷰 작성 완료</p>
                
                <% } else { %>
                  <form 
                    method="post"
                    action="/reviews"
                    class="review-form"
                  >
                    <input
                      type="hidden"
                      name="_csrf"
                      value="<%= csrfToken %>"
                    >

                    <input
                      type="hidden"
                      name="orderItemId"
                      value="<%= item.id %>"
                    >

                    <div class="review-field">
                      <label for="rating-<%= item.id %>">평점</label>
                      
                      <select 
                        id="rating-<%= item.id %>"
                        name="rating"
                        required
                      >
                        <option value="">평점을 선택해주세요.</option>
                        <option vlaue="5">5점 - 매우 만족</option>
                        <option vlaue="4">4점 - 만족</option>
                        <option vlaue="3">3점 - 보통</option>
                        <option vlaue="2">2점 - 불만족</option>
                        <option vlaue="1">1점 - 매우 불만족</option>
                      </select>
                    </div>

                    <div class="review-field">
                      <label for="conetent-<%= item.id %>">리뷰 내용</label>
                    
                    <textarea
                      id="content-<%= item.id%>"
                      name="content"
                      minlength="2"
                      maxlength="2000"
                      rows="5"
                      placeholder="상품에 대한 리뷰를 작성해주세요."
                      required>
                      </textarea>
                    </div>

                    <button
                      type="submit"
                      class="review-submit-button">리뷰 등록</button>  
                  </form>
                <% } %>
              </div>
            </article>
          <% }); %>

        <% } else { %>
          <p>주문 상품이 없습니다.</p>
        <% } %>
      </section>

      <div class="order-actions">
        <a href="/orders/history">
          주문 내역
        </a>

        <a href="/">
          쇼핑 계속하기
        </a>
      </div>
    </section>
  </main>
</body>
</html>