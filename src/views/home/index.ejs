<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title || '쇼핑몰' %></title>

  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/index.css">

  <script src="/js/jquery-1.12.3.js" defer></script>
  <script src="/js/common.js" defer></script>
</head>

<body>
  <!-- 로그인 영역 -->
  <nav id="navBar">
    <% if (
      typeof currentUser !== 'undefined' &&
      currentUser
    ) { %>
      <span class="welcome-message">
        환영합니다,
        <strong><%= currentUser.name || currentUser.username %></strong>님!
      </span>

      <form
        class="logout-form"
        method="post"
        action="/auth/logout"
      >
        <button type="submit" class="logout-button">
          로그아웃
        </button>
      </form>
    <% } else { %>
      <a href="/auth/register">회원가입</a>
      <a href="/auth/login">로그인</a>
    <% } %>
  </nav>

  <!-- 팝업 -->
  <div class="popup">
    <h2>후기 적립금 안내</h2>

    <p>
      #적립금 챙겨가세요!<br>
      #후기만 남겨도 적립금이 빵빵!<br>
      HANSEI 쇼핑몰 회원님들의 구매 후 솔직한 의견을
      남겨주시는 구매후기입니다.<br>
      구매하신 상품을 착용하시고 사진을 찍어 구매후기를
      작성해주시기 바랍니다.<br>
      <br>
      - 적립금은 작성 후 2~7일 이내 지급<br>
      - 의도적인 비방글, 도배, 욕설 등은 사전 공지 없이
      자동 삭제될 수 있습니다.<br>
    </p>

    <button type="button">닫기</button>
  </div>

  <!-- 헤더 -->
  <div class="header">
    <h1>
      <a href="/">
        <img src="/images/logo.png" alt="HANSEI 쇼핑몰 로고">
      </a>
    </h1>

    <div class="gnb">
      <ul>
        <li>
          <a href="/products?category=tshirt" class="mainnav">
            Top
          </a>

          <ul class="subnav">
            <li>
              <a href="/products?category=tshirt">티셔츠</a>
            </li>
            <li>
              <a href="/products?category=blouse">블라우스</a>
            </li>
            <li>
              <a href="/products?category=hood">후드</a>
            </li>
            <li>
              <a href="/products?category=knitwear">니트</a>
            </li>
          </ul>
        </li>

        <li>
          <a href="/products?category=jeans" class="mainnav">
            Pants
          </a>

          <ul class="subnav">
            <li>
              <a href="/products?category=jeans">청바지</a>
            </li>
            <li>
              <a href="/products?category=slacks">슬랙스</a>
            </li>
          </ul>
        </li>

        <li>
          <a href="/products?category=coat" class="mainnav">
            Outer
          </a>

          <ul class="subnav">
            <li>
              <a href="/products?category=coat">코트</a>
            </li>
            <li>
              <a href="/products?category=cardigan">가디건</a>
            </li>
          </ul>
        </li>

        <li>
          <a href="/products?category=earring" class="mainnav">
            Acc
          </a>

          <ul class="subnav">
            <li>
              <a href="/products?category=earring">귀걸이</a>
            </li>
            <li>
              <a href="/products?category=necklace">목걸이</a>
            </li>
            <li>
              <a href="/products?category=ring">반지</a>
            </li>
            <li>
              <a href="/products?category=bracelet">팔찌</a>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>

  <!-- 메인 슬라이드 -->
  <div class="main">
    <ul>
      <li>
        <a href="/products">
          <img src="/images/main01.png" alt="메인 상품 이미지 1">
        </a>
      </li>

      <li>
        <a href="/products">
          <img src="/images/main02.png" alt="메인 상품 이미지 2">
        </a>
      </li>

      <li>
        <a href="/products">
          <img src="/images/main03.png" alt="메인 상품 이미지 3">
        </a>
      </li>
    </ul>
  </div>

  <!-- 콘텐츠 -->
  <div class="contents">
    <div class="board">
      <ul class="btn">
        <li>
          <a href="#" class="active">공지사항</a>
        </li>
        <li>
          <a href="#">갤러리</a>
        </li>
      </ul>

      <div class="bwrap">
        <div class="notice">
          <ul>
            <li>
              <a href="#" class="popupopen">
                · HANSEI 쇼핑몰 사이트 후기 적립금 안내
              </a>
              <span class="date">2025.03.05</span>
            </li>

            <li>
              <a href="#">
                · 주문 후 배송 전 취소/반품/상품교환 유의사항
              </a>
              <span class="date">2025.03.02</span>
            </li>

            <li>
              <a href="#">· 교환 및 반품 Q&amp;A</a>
              <span class="date">2025.02.11</span>
            </li>

            <li>
              <a href="#">· 설 연휴 휴무 및 배송 안내</a>
              <span class="date">2025.01.15</span>
            </li>

            <li>
              <a href="#">· 대한택배 파업 관련 발송 대책 공지</a>
              <span class="date">2025.01.11</span>
            </li>
          </ul>
        </div>

        <div class="gallery">
          <ul>
            <li>
              <a href="/products">
                <img src="/images/gall01.png" alt="상품 갤러리 1">
              </a>
            </li>

            <li>
              <a href="/products">
                <img src="/images/gall02.png" alt="상품 갤러리 2">
              </a>
            </li>

            <li>
              <a href="/products">
                <img src="/images/gall03.png" alt="상품 갤러리 3">
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="banner">
      <a href="/products">
        <img src="/images/banner.png" alt="쇼핑몰 배너">
      </a>
    </div>

    <div class="now">
      <a href="/products">
        <img src="/images/now.png" alt="현재 인기 상품">
      </a>
    </div>
  </div>

  <!-- AI 리뷰 분석 소개 -->
  <section class="ai-review-section">
    <div class="ai-review-heading">
      <span>AI REVIEW ANALYSIS</span>
      <h2>AI가 구매 후기를 분석해 드립니다</h2>

      <p>
        구매 고객의 리뷰에서 감정, 주요 키워드와
        핵심 내용을 자동으로 분석합니다.
      </p>
    </div>

    <div class="ai-feature-list">
      <article>
        <h3>감정 분석</h3>
        <p>리뷰를 긍정, 중립, 부정으로 분류합니다.</p>
      </article>

      <article>
        <h3>키워드 추출</h3>
        <p>사이즈, 재질, 핏, 색상 등 주요 정보를 추출합니다.</p>
      </article>

      <article>
        <h3>리뷰 요약</h3>
        <p>여러 구매 후기의 핵심 내용을 간결하게 제공합니다.</p>
      </article>
    </div>

    <a href="/products" class="ai-product-button">
      AI 리뷰 상품 확인하기
    </a>
  </section>

  <!-- 푸터 -->
  <div class="footer">
    <h1>
      <a href="/">
        <img
          src="/images/footer_logo.png"
          alt="HANSEI 쇼핑몰 푸터 로고"
        >
      </a>
    </h1>

    <p>Copyright ⓒ HANSEI. All rights reserved.</p>

    <ul class="sns">
      <li><a href="#">FACEBOOK</a></li>
      <li><a href="#">INSTAGRAM</a></li>
      <li><a href="#">TWITTER</a></li>
    </ul>
  </div>
</body>
</html>